# Future backend API URL (not used in frontend-only mock mode)
VITE_API_BASE_URL=http://localhost:3000/api

# Groq API for ODEJ youth assistant (server-side only — never VITE_ prefix)
# Get a key at https://console.groq.com
#
# Local: copy to .env or .env.local
# Vercel: Project → Settings → Environment Variables → GROQ_API_KEY (Production + Preview)
GROQ_API_KEY=
